# ── Paths ──────────────────────────────────────────────────────────────────
# Repo root, or absolute paths. Leave blank to resolve relative to backend/app.
PROJECT_ROOT=

# Williams-Sonoma demand (MODEL1)
DATA_DIR=ws_demand_dataset
WS_MODEL_DIR=ws_model
ML_READY_FILE=ml_ready_data.csv

# Influencer models (MODEL2)
INFLUENCER_MODEL_DIR=models
FEATURES_ENGINEERED_FILE=features_engineered.csv

# City growth model (MODEL3 / conti)
CONTI_MODEL_DIR=models

# Generated tables (ETL output)
ANALYTICS_DIR=analytics
CASE_STUDY_DATA_DIR=data

# ── Service ────────────────────────────────────────────────────────────────
APP_NAME=Supply Chain Analytics API
APP_VERSION=1.0.0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── HTTP ───────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist. Using "*" disables credentialed CORS,
# because browsers reject a wildcard origin on credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Send Strict-Transport-Security. Enable ONLY when served over HTTPS —
# on a plain-HTTP dev server this can lock your browser out of localhost.
ENABLE_HSTS=false
